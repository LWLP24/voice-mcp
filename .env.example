CALLTOOL_ENV=development
CALLTOOL_CONFIG=/app/config/calltool.yaml
CALLTOOL_API_KEY=change-me
CALLTOOL_LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

DATABASE_URL=postgresql://calltool:calltool@postgres:5432/calltool
REDIS_URL=redis://redis:6379/0

LIVEKIT_URL=ws://host.docker.internal:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=calltool-local-dev-secret-please-change-before-production
LIVEKIT_SIP_TRUNK_ID=

TELNYX_SIP_ADDRESS=sip.telnyx.eu
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_FROM_NUMBER=

GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional global overrides. Empty values use config/calltool.yaml.
CALLTOOL_VOICE_PROVIDER=
CALLTOOL_VOICE_MODEL=
CALLTOOL_VOICE_LANGUAGE=
CALLTOOL_VOICE_NAME=
CALLTOOL_PROMPT_DIR=
CALLTOOL_TURN_DETECTION_MODE=
# Optional 0..1 overrides for livekit_v1_mini; calibrate with German eval calls.
CALLTOOL_TURN_UNLIKELY_THRESHOLD=
CALLTOOL_TURN_BACKCHANNEL_THRESHOLD=
# LiveKit endpointing bounds in seconds; defaults are 0.3 / 1.0.
CALLTOOL_ENDPOINTING_MIN_DELAY=
CALLTOOL_ENDPOINTING_MAX_DELAY=
CALLTOOL_INTERRUPTION_MODE=
CALLTOOL_IVR_ENABLED=
CALLTOOL_AMD_ENABLED=
CALLTOOL_COLD_TRANSFER_ENABLED=
CALLTOOL_KRISP_ENABLED=

WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=change-me

CALLTOOL_DOMAIN=localhost
LIVEKIT_DOMAIN=livekit.localhost
